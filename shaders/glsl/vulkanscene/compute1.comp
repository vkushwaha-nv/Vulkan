#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_buffer_reference : enable
#extension GL_EXT_buffer_reference_uvec2 : enable

layout (local_size_x = 32, local_size_y = 1) in;

layout(push_constant) uniform PushConstants {
    uint srcOffset;
    uint dstOffset;
    uint size;
    float time;       // Animation time parameter
    float waveHeight; // Controls the amplitude of the wave
    float waveFreq;   // Controls the frequency of oscillation
    float temp4;      // Unused
    uint crashType;   // Type of crash to simulate (0 = none)
    uint crashValue1; // Additional crash parameter 1
    uint crashValue2; // Additional crash parameter 2
} pushConstants;

// Define the vertex structure to exactly match the C++ Vertex struct
// In C++: struct Vertex { float position[4]; float color[3]; };
struct Vertex {
    float position_x;
    float position_y;
    float position_z;
    float position_w;
    float color_r;
    float color_g;
    float color_b;
};

layout(std430, binding=0) buffer ReadData {
    Vertex inData[];
};

layout(std430, binding=1) buffer WriteData {
    Vertex outData[];
};

layout(std430, binding=2) buffer CrashBuffer {
    vec4 crashData[];
};

// Define a buffer reference type for arbitrary memory access
layout(buffer_reference, std430) readonly buffer MyData {
    float value;
};

void main()
{
    uint idx = gl_GlobalInvocationID.x;
    if (idx < pushConstants.size / 28) { // 28 bytes per vertex (7 floats * 4 bytes)
        // Copy the vertex data
        Vertex vertex = inData[pushConstants.srcOffset + idx];
        
        // Check for crash conditions
        if (pushConstants.crashType == 1) {
            // Use crashValue1 directly as the invalid index to access the crash buffer
            uint invalidIndex = pushConstants.crashValue1 + pushConstants.crashValue2;
            
            // Try to access the crash buffer with the invalid index
            vec4 crashValue = crashData[invalidIndex];
            
            // Use the crash value to modify the vertex
            vertex.position_x += crashValue.x;
            vertex.position_y += crashValue.y;
            vertex.position_z += crashValue.z;
            
            // Write to the output buffer to ensure the operation isn't optimized away
            outData[pushConstants.dstOffset + idx] = vertex;
        }
        else if (pushConstants.crashType == 2) {
            // Simple division by zero crash
            float result = float(pushConstants.crashValue1) / float(pushConstants.crashValue2);
            
            // Apply the crash result to the vertex position
            vertex.position_x = result * 0.1;
            vertex.position_y = result * 0.1;
            vertex.position_z = result * 0.1;

            // Output the modified vertex
            outData[pushConstants.dstOffset + idx] = vertex;
            return;
        }
        else if (pushConstants.crashType == 3) {
            // Simple infinite loop
            
            while (pushConstants.crashValue1 == pushConstants.crashValue2) {
                // Keep changing vertex position in the loop
                vertex.position_x = vertex.position_x * 0.99 + 0.01;
                vertex.position_y = vertex.position_y * 0.99 + 0.01;
                vertex.position_z = vertex.position_z * 0.99 + 0.01;
            }
        }
        else if (pushConstants.crashType == 4) {
            // Use buffer reference to access arbitrary GPU memory
            uvec2 addrVec = uvec2(pushConstants.crashValue1, pushConstants.crashValue2);
            MyData myPtr = MyData(addrVec);
            float value = myPtr.value;  // Attempt to access arbitrary memory
            
            // Use the value from arbitrary memory to modify the vertex
            vertex.position_x += value;
            vertex.position_y += value;
            vertex.position_z += value;
            
            // Write to the output buffer to ensure the operation isn't optimized away
            outData[pushConstants.dstOffset + idx] = vertex;
        }
        
        // Apply a wave animation based on the vertex position and time
        // Calculate distance from origin in 3D space to better identify core vertices
        float distXYZ = length(vec3(vertex.position_x, vertex.position_y, vertex.position_z));
        
        // Apply a threshold to prevent core vertices from moving
        float coreThreshold = 10.0; // Adjust based on your scene scale
        
        // Set a clear boundary between core and non-core regions
        // Core vertices (with distance < threshold) will have attenuation = 0
        float coreAttenuation = distXYZ < coreThreshold ? 0.0 : 
                                mix(0.0, 0.8, clamp((distXYZ - coreThreshold) / 15.0, 0.0, 1.0));
        
        // Create independent oscillation for each vertex
        // Use position to create phase differences between vertices
        float phase = dot(vec3(vertex.position_x, vertex.position_y, vertex.position_z), 
                          vec3(0.4, 0.2, 0.3)); // Different weights create varied movement
        
        // Create a reset cycle over time - goes from 0 to 1 and back to 0
        float resetCycle = abs(sin(pushConstants.time * 0.1)); // Slower, more subtle cycle
        
        // Simple sine oscillation with phase offset
        float oscillation = sin(pushConstants.time * pushConstants.waveFreq + phase * 3.0);
        
        // Apply attenuation and reset cycle
        float waveFactor = oscillation * pushConstants.waveHeight * coreAttenuation * resetCycle;
        
        // Apply the wave to the y position 
        vertex.position_y += waveFactor;
        
        // Output the modified vertex
        outData[pushConstants.dstOffset + idx] = vertex;
    }
}
