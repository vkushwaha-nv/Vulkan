#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

layout (local_size_x = 32, local_size_y = 1) in;

layout(push_constant) uniform PushConstants {
    uint srcOffset;
    uint dstOffset;
    uint size;
    float time;       // Animation time parameter
    float waveHeight; // Controls the amplitude of the wave
    float waveFreq;   // Controls the frequency of oscillation
    float delayFactor; // Controls shader execution time (1.0 = normal speed)
    uint crashType;   // Type of crash to simulate (0 = none)
    uint crashValue1; // Additional crash parameter 1
    uint crashValue2; // Additional crash parameter 2
} pushConstants;

// Define the vertex structure to exactly match the C++ Vertex struct
// In C++: struct Vertex { float position[4]; float color[3]; };
struct Vertex {
    float position_x;
    float position_y;
    float position_z;
    float position_w;
    float color_r;
    float color_g;
    float color_b;
};

layout(std430, binding=0) buffer ReadData {
    Vertex inData[];
};

layout(std430, binding=1) buffer WriteData {
    Vertex outData[];
};

void main()
{
    uint idx = gl_GlobalInvocationID.x;
    if (idx < pushConstants.size / 28) { // 28 bytes per vertex (7 floats * 4 bytes)
        // Copy the vertex data
        Vertex vertex = inData[pushConstants.srcOffset + idx];
        
        // Calculate distance from center
        float distFromCenter = length(vec3(vertex.position_x, vertex.position_y, vertex.position_z));
        
        // Apply a threshold to prevent core vertices from moving
        float coreThreshold = 10.0;
        
        if (distFromCenter > coreThreshold) {
            // Get original vertex position
            vec3 originalPos = vec3(vertex.position_x, vertex.position_y, vertex.position_z);
            
            // Normalized direction vector from origin to vertex
            vec3 direction = normalize(originalPos);
            
            // Create breathing/pulsing effect
            float breathingFreq = 0.8; // Slower breathing rate
            float breathingPhase = pushConstants.time * breathingFreq;
            
            // Create a breathing cycle that goes from -1 to 1 instead of 0 to 1
            // This ensures we have both contraction and expansion
            float breathingCycle = cos(breathingPhase);
            
            // Apply different rates of breathing based on vertex color
            // This creates variations in the animation across different cube faces
            float colorFactor = 1.0 + 0.2 * (vertex.color_r + vertex.color_g + vertex.color_b) / 3.0;
            breathingCycle *= colorFactor;
            
            // Calculate distance-based attenuation
            float attenuation = clamp((distFromCenter - coreThreshold) / 15.0, 0.0, 1.0);
            
            // Calculate amplitude factor
            float amplitudeFactor = 0.02 * pushConstants.waveHeight * attenuation;
            
            // Calculate the movement offset - now properly contracts when breathingCycle is negative
            vec3 moveVec = direction * breathingCycle * amplitudeFactor * distFromCenter;
            
            // Apply the movement to the vertex
            vertex.position_x += moveVec.x;
            vertex.position_y += moveVec.y; 
            vertex.position_z += moveVec.z;
        }
        
        // Artificial delay loop controlled by delayFactor
        float dummy = 0.0;
        uint delayIters = uint(max(1.0, pushConstants.delayFactor * 1000.0));
        for (uint i = 0; i < delayIters; ++i) {
            // Accumulate a small value that will be used to modify the vertex
            dummy += sin(float(i)) * 0.00001;
        }
        
        // Use the dummy value to slightly modify the vertex position
        // This ensures the loop can't be optimized out
        vertex.position_x += dummy;
        vertex.position_y += dummy;
        vertex.position_z += dummy;
        
        // Output the modified vertex
        outData[pushConstants.dstOffset + idx] = vertex;
    }
}
