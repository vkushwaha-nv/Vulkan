#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

layout (local_size_x = 32, local_size_y = 1) in;

layout(push_constant) uniform PushConstants {
    uint srcOffset;
    uint dstOffset;
    uint size;
    float time;       // Animation time parameter
    float waveHeight; // Controls the amplitude of the wave
    float waveFreq;   // Controls the frequency of oscillation
    float temp4;      // Unused
    uint crashType;   // Type of crash to simulate (0 = none)
    uint crashValue1; // Additional crash parameter 1
    uint crashValue2; // Additional crash parameter 2
} pushConstants;

// Define the vertex structure to exactly match the C++ Vertex struct
// In C++: struct Vertex { float position[4]; float color[3]; };
struct Vertex {
    float position_x;
    float position_y;
    float position_z;
    float position_w;
    float color_r;
    float color_g;
    float color_b;
};

layout(std430, binding=0) buffer ReadData {
    Vertex inData[];
};

layout(std430, binding=1) buffer WriteData {
    Vertex outData[];
};

void main()
{
    uint idx = gl_GlobalInvocationID.x;
    if (idx < pushConstants.size / 28) { // 28 bytes per vertex (7 floats * 4 bytes)
        // Copy the vertex data
        Vertex vertex = inData[pushConstants.srcOffset + idx];
        
        // Calculate distance from center (in xz plane)
        float distXZ = sqrt(vertex.position_x * vertex.position_x + vertex.position_z * vertex.position_z);
        
        // Apply a threshold to prevent core vertices from moving
        float coreThreshold = 10.0;
        
        if (distXZ > coreThreshold) {
            // Create a twist effect around Y axis based on Y position
            float twistFactor = vertex.position_y * pushConstants.waveFreq;
            float rotationAngle = sin(pushConstants.time + twistFactor) * pushConstants.waveHeight;
            
            // Calculate new X and Z coordinates with rotation
            float cosAngle = cos(rotationAngle);
            float sinAngle = sin(rotationAngle);
            float newX = vertex.position_x * cosAngle - vertex.position_z * sinAngle;
            float newZ = vertex.position_x * sinAngle + vertex.position_z * cosAngle;
            
            // Apply attenuation based on distance from center
            float attenuation = clamp((distXZ - coreThreshold) / 20.0, 0.0, 1.0);
            
            // Blend original and transformed positions
            vertex.position_x = mix(vertex.position_x, newX, attenuation);
            vertex.position_z = mix(vertex.position_z, newZ, attenuation);
        }
        
        // Output the modified vertex
        outData[pushConstants.dstOffset + idx] = vertex;
    }
}
