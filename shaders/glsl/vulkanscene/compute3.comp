#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

layout (local_size_x = 32, local_size_y = 1) in;

layout(push_constant) uniform PushConstants {
    uint srcOffset;
    uint dstOffset;
    uint size;
    float time;       // Animation time parameter
    float waveHeight; // Controls the amplitude of the wave
    float waveFreq;   // Controls the frequency of oscillation
    float temp4;      // Unused
    uint crashType;   // Type of crash to simulate (0 = none)
    uint crashValue1; // Additional crash parameter 1
    uint crashValue2; // Additional crash parameter 2
} pushConstants;

// Define the vertex structure to exactly match the C++ Vertex struct
// In C++: struct Vertex { float position[4]; float color[3]; };
struct Vertex {
    float position_x;
    float position_y;
    float position_z;
    float position_w;
    float color_r;
    float color_g;
    float color_b;
};

layout(std430, binding=0) buffer ReadData {
    Vertex inData[];
};

layout(std430, binding=1) buffer WriteData {
    Vertex outData[];
};

void main()
{
    uint idx = gl_GlobalInvocationID.x;
    if (idx < pushConstants.size / 28) { // 28 bytes per vertex (7 floats * 4 bytes)
        // Copy the vertex data
        Vertex vertex = inData[pushConstants.srcOffset + idx];
        
        // Calculate distance from origin (center)
        float dist = length(vec3(vertex.position_x, vertex.position_y, vertex.position_z));
        
        // Apply a threshold to prevent core vertices from moving
        float coreThreshold = 10.0;
        
        if (dist > coreThreshold) {
            // Create a pulsating effect from the center
            float pulse = sin(pushConstants.time * 2.0) * cos(dist * pushConstants.waveFreq);
            
            // Calculate direction from center
            vec3 dir = normalize(vec3(vertex.position_x, vertex.position_y, vertex.position_z));
            
            // Apply an attenuation factor based on distance from center
            float attenuationFactor = 1.0 - smoothstep(coreThreshold, 30.0, dist);
            
            // Scale the effect by the wave height and attenuation
            float effectStrength = pushConstants.waveHeight * attenuationFactor * pulse;
            
            // Add a pulsating effect to all axes
            vertex.position_x += dir.x * effectStrength;
            vertex.position_y += dir.y * effectStrength;
            vertex.position_z += dir.z * effectStrength;
        }
        
        // Output the modified vertex
        outData[pushConstants.dstOffset + idx] = vertex;
    }
}
